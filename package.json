{
  "name": "claude-account-profiles",
  "displayName": "Claude Account Profiles",
  "description": "Keep several Claude Code accounts signed in, pick one per project automatically, and switch quickly from the status bar.",
  "version": "0.4.1",
  "publisher": "kuon",
  "icon": "images/icon.png",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuon-bui/claude-mutil.git"
  },
  "bugs": {
    "url": "https://github.com/kuon-bui/claude-mutil/issues"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeAccounts.switch",
        "category": "Claude Accounts",
        "title": "Switch Account"
      },
      {
        "command": "claudeAccounts.add",
        "category": "Claude Accounts",
        "title": "Add Account"
      },
      {
        "command": "claudeAccounts.manage",
        "category": "Claude Accounts",
        "title": "Manage Profiles"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build:css": "tailwindcss -i src/webview/input.css -o dist/webview.css",
    "build": "node esbuild.mjs && npm run build:css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.98.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}

{
  "name": "claude-account-switcher",
  "displayName": "Claude Accounts",
  "description": "Giữ sẵn đăng nhập của nhiều tài khoản Claude Code, tự chọn theo dự án, đổi nhanh từ thanh trạng thái.",
  "version": "0.1.0",
  "publisher": "claude-accounts-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      { "command": "claudeAccounts.switch", "category": "Claude Accounts", "title": "Đổi tài khoản" },
      { "command": "claudeAccounts.add", "category": "Claude Accounts", "title": "Thêm tài khoản" },
      { "command": "claudeAccounts.manage", "category": "Claude Accounts", "title": "Quản lý hồ sơ" }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.98.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}

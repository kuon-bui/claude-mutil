{
  "name": "claude-account-switcher",
  "displayName": "Claude Accounts",
  "description": "Keep several Claude Code accounts signed in, pick one per project automatically, and switch quickly from the status bar.",
  "version": "0.1.0",
  "publisher": "claude-accounts-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      { "command": "claudeAccounts.switch", "category": "Claude Accounts", "title": "Switch Account" },
      { "command": "claudeAccounts.add", "category": "Claude Accounts", "title": "Add Account" },
      { "command": "claudeAccounts.manage", "category": "Claude Accounts", "title": "Manage Profiles" }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.98.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
